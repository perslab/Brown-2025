DE_con<-readRDS("/projects/perslab/data/yggdrasil/projects/nvg559/Glucose_paper/Brown-2024/Output/DE_noNA/DEGs_edgeR_ARC_nonneurons_Controldiet_glucoseresponse_final_no_NA.rds")
DE_HF<-readRDS("/projects/perslab/data/yggdrasil/projects/nvg559/Glucose_paper/Brown-2024/Output/DE_noNA/DEGs_edgeR_ARC_nonneurons_HFdiet_glucoseresponse_final_no_NA.rds")

# Initialize a data frame to store results
results_df <- data.frame(Cell_Type = character(),
                         tau = numeric(),
                         p_value = numeric(),
                         stringsAsFactors = FALSE)

# Get the list of cell types from the names of DE_con (assuming DE_con and DE_HF have the same structure)
cell_types <- names(DE_con)

# Loop over each cell type
for (cell_type in cell_types) {
  
  # Extract the data frame for the current cell type from both lists
  con_data <- DE_con[[cell_type]] 
  hf_data <- DE_HF[[cell_type]]
  
  # Add the 'Gene' column for merging (assuming 'Gene' is the row names in both data frames)
  con_data$Gene <- rownames(con_data)
  hf_data$Gene <- rownames(hf_data)
  
  # Reset row names
  rownames(con_data) <- NULL
  rownames(hf_data) <- NULL
  
  # Merge the data frames by the 'Gene' column
  merged_df <- merge(con_data, hf_data, by = "Gene", suffixes = c("_con", "_hf"))
  
  # Check if the logFC columns exist in both merged data frames
  if ("logFC_con" %in% colnames(merged_df) && "logFC_hf" %in% colnames(merged_df)) {
    
    # Run the Kendall correlation test on logFC for this cell type
    test_result <- cor.test(merged_df$logFC_con, merged_df$logFC_hf, method = "kendall")
    
    # Store the tau (estimate) and p-value in the results data frame
    results_df <- rbind(results_df, data.frame(Cell_Type = cell_type, 
                                               tau = test_result$estimate,
                                               p_value = test_result$p.value))
  } else {
    # If logFC columns are missing, handle the error (optional)
    warning(paste("logFC column missing for cell type:", cell_type))
  }
}

# Adjust the p-values for multiple testing using the Benjamini-Hochberg method
results_df$adjusted_p_value <- p.adjust(results_df$p_value, method = "BH")

# Add a significance column based on the adjusted p-value (threshold = 0.05)
results_df$significance <- ifelse(results_df$adjusted_p_value < 0.05, "significant", "not_significant")

# Display the results dataframe with tau, p-values, adjusted p-values, and significance
print(results_df)

