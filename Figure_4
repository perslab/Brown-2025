## Helper functions

```{r functions}
make_ranked_list <- function(de_df) {

  de_df %>%
    rownames_to_column("Gene") %>%
    filter(!is.na(logFC), !is.na(PValue)) %>%
    mutate(
      score = if_else(
        logFC > 0,
        -log10(PValue),
        -log10(PValue) * -1
      )
    ) %>%
    arrange(desc(score)) %>%
    dplyr::select(Gene, score)
}

run_rrho_for_celltype <- function(celltype, arc_de, dvc_de) {

  arc_rank <- make_ranked_list(arc_de[[celltype]])
  dvc_rank <- make_ranked_list(dvc_de[[celltype]])

  common_genes <- intersect(arc_rank$Gene, dvc_rank$Gene)

  arc_rank <- arc_rank %>% filter(Gene %in% common_genes)
  dvc_rank <- dvc_rank %>% filter(Gene %in% common_genes)

  RRHO2_initialize(
    dvc_rank,
    arc_rank,
    labels = c("DVC glucose response", "ARC/VMH glucose response"),
    log10.ind = TRUE
  )
}

run_gost_clean <- function(
    genes,
    background_genes,
    celltype,
    direction,
    max_term_size = 500
) {

  if (length(genes) < 3) {
    return(tibble())
  }

  gost_out <- gost(
    query = genes,
    organism = "mmusculus",
    custom_bg = background_genes,
    ordered_query = FALSE,
    correction_method = "fdr",
    exclude_iea = TRUE,
    sources = c("GO:BP", "GO:MF", "GO:CC"),
    evcodes = FALSE
  )

  if (is.null(gost_out$result)) {
    return(tibble())
  }

  gost_out$result %>%
    dplyr::select(
      term_name,
      term_size,
      source,
      p_value,
      intersection_size,
      term_id
    ) %>%
    filter(term_size <= max_term_size) %>%
    arrange(p_value) %>%
    mutate(
      celltype = celltype,
      direction = direction,
      group = paste(celltype, direction, sep = "_"),
      neg_log10_p = -log10(p_value)
    )
}

get_background_genes <- function(seurat_obj, celltype) {
  cell_obj <- subset(seurat_obj, subset = sub.class == celltype)
  rownames(cell_obj[["RNA"]])
}

get_rrho_go_for_celltype <- function(celltype, arc_de, dvc_de, seurat_obj) {

  rrho_obj <- run_rrho_for_celltype(
    celltype = celltype,
    arc_de = arc_de,
    dvc_de = dvc_de
  )

  background_genes <- get_background_genes(seurat_obj, celltype)

  go_up <- run_gost_clean(
    genes = rrho_obj$genelist_uu$gene_list_overlap_uu,
    background_genes = background_genes,
    celltype = celltype,
    direction = "Co-up"
  )

  go_down <- run_gost_clean(
    genes = rrho_obj$genelist_dd$gene_list_overlap_dd,
    background_genes = background_genes,
    celltype = celltype,
    direction = "Co-down"
  )

  list(
    rrho = rrho_obj,
    go = bind_rows(go_up, go_down)
  )
}

make_rrho_go_heatmap_data <- function(
    go_all,
    top_n_terms = 5,
    group_order = c(
      "Astrocytes_Co-up",
      "Oligodendrocytes_Co-up",
      "Astrocytes_Co-down",
      "Oligodendrocytes_Co-down"
    )
) {

  go_all <- go_all %>%
    as.data.frame() %>%
    dplyr::mutate(
      term_name = as.character(term_name),
      group = as.character(group),
      p_value = as.numeric(p_value),
      neg_log10_p = as.numeric(neg_log10_p)
    )

  top_terms <- go_all %>%
    dplyr::group_by(group) %>%
    dplyr::arrange(p_value, .by_group = TRUE) %>%
    dplyr::slice_head(n = top_n_terms) %>%
    dplyr::ungroup() %>%
    dplyr::pull(term_name) %>%
    unique()

  complete_grid <- tidyr::expand_grid(
    group = group_order,
    term_name = top_terms
  )

  heatmap_data <- complete_grid %>%
    dplyr::left_join(
      go_all %>%
        dplyr::select(group, term_name, source, p_value, neg_log10_p, celltype, direction),
      by = c("group", "term_name")
    ) %>%
    dplyr::mutate(
      group = factor(
        group,
        levels = group_order,
        labels = c(
          "Astrocytes\nCo-up",
          "Oligodendrocytes\nCo-up",
          "Astrocytes\nCo-down",
          "Oligodendrocytes\nCo-down"
        )
      ),
      term_label = stringr::str_to_title(stringr::str_wrap(term_name, 22))
    )

  term_order <- go_all %>%
    dplyr::filter(term_name %in% top_terms) %>%
    dplyr::mutate(group = factor(group, levels = group_order)) %>%
    dplyr::arrange(group, p_value) %>%
    dplyr::distinct(term_name, .keep_all = TRUE) %>%
    dplyr::mutate(term_label = stringr::str_to_title(stringr::str_wrap(term_name, 22))) %>%
    dplyr::pull(term_label)

  heatmap_data %>%
    dplyr::mutate(term_label = factor(term_label, levels = rev(unique(term_order))))
}

plot_rrho_go_heatmap <- function(
    heatmap_data,
    max_fill = 7,
    x_angle = 45
) {

  ggplot(
    heatmap_data,
    aes(x = group, y = term_label, fill = neg_log10_p)
  ) +
    geom_tile(color = "white", linewidth = 0.5) +
    scale_fill_gradient(
      low = "white",
      high = "#8B1A1A",
      na.value = "white",
      limits = c(0, max_fill),
      oob = scales::squish,
      name = expression(-log[10](italic(P)))
    ) +
    theme_classic(base_size = 10) +
    theme(
      axis.title = element_blank(),
      axis.text.x = element_text(angle = x_angle, hjust = 1, vjust = 1),
      axis.text.y = element_text(size = 8),
      axis.line = element_blank(),
      axis.ticks = element_blank(),
      legend.title = element_text(size = 10),
      legend.text = element_text(size = 8),
      panel.border = element_rect(color = "black", fill = NA, linewidth = 0.4)
    )
}
