control_df <- edgr_list_Control[["Ghrh"]] %>% rownames_to_column("gene")
highfat_df <- edgr_list_HFD[["Ghrh"]] %>% rownames_to_column("gene")

plot_significant_genes <- function(control_df, highfat_df, cell_type, fdr_cutoff = 0.05) {
  
  # 1. Subset each data frame for the specified cell type
  control_subset <- control_df %>% 
    filter(cell_type == cell_type)
  
  highfat_subset <- highfat_df %>%
    filter(cell_type == cell_type)
  
  # 2. Filter for genes significant in Control (FDR < fdr_cutoff)
  sig_control <- control_subset %>%
    filter(FDR < fdr_cutoff)
  
  # 3. Extract the set of significant genes
  sig_genes <- sig_control$gene
  
  # 4. Subset High Fat by these significant genes
  highfat_subset_sig <- highfat_subset %>%
    filter(gene %in% sig_genes)
  
  # 5. Combine logFC from both into one data frame
  combined_df <- sig_control %>%
    dplyr::select(gene, logFC_control = logFC) %>%
    left_join(
      highfat_subset_sig %>%
        dplyr::select(gene, logFC_highfat = logFC),
      by = "gene"
    )
  
  # 6. Sort by descending logFC_control for plotting
  heatmap_df <- combined_df %>%
    arrange(desc(logFC_control))
  
  # 7. Create a matrix of just logFC columns and set row names
  heatmap_mat <- as.matrix(heatmap_df[, c("logFC_control", "logFC_highfat")])
  rownames(heatmap_mat) <- heatmap_df$gene
  
  # 8. Draw the heatmap without clustering rows (so it shows descending order)
  pheatmap(
    heatmap_mat,
    cluster_rows = T,   # preserve manual ordering
    cluster_cols = FALSE,   # optional; set to TRUE if you want column clustering
    scale        = "none",
    main         = paste("Significant Genes (Control vs High Fat) -", cell_type)
  )
    
  source_data <- combined_df %>%
  dplyr::mutate(cell_type = cell_type) %>%
  dplyr::select(cell_type, gene, logFC_control, logFC_highfat)
   return(source_data)  
}

