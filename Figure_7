```{r}
control_df <- edgr_list_Control[["Agrp"]] %>% rownames_to_column("gene")
highfat_df <- edgr_list_HFD[["Agrp"]] %>% rownames_to_column("gene")

plot_significant_genes_clustered <- function(control_df, highfat_df, cell_type, fdr_cutoff = 0.05) {
  
  # 1. Subset each data frame for the specified cell type
  control_subset <- control_df %>% 
    filter(cell_type == cell_type)
  
  highfat_subset <- highfat_df %>%
    filter(cell_type == cell_type)
  
  # 2. Filter for genes significant in Control (FDR < fdr_cutoff)
  sig_control <- control_subset %>%
    filter(FDR < fdr_cutoff)
  
  # 3. Extract the set of significant genes
  sig_genes <- sig_control$gene
  
  # 4. Subset High Fat by these significant genes
  highfat_subset_sig <- highfat_subset %>%
    filter(gene %in% sig_genes)
  
  # 5. Combine logFC from both into one data frame
  combined_df <- sig_control %>%
    dplyr::select(gene, logFC_control = logFC) %>%
    left_join(
      highfat_subset_sig %>%
        dplyr::select(gene, logFC_highfat = logFC),
      by = "gene"
    )
  
  source_data <- combined_df %>%
  dplyr::mutate(cell_type = cell_type) %>%
  dplyr::select(cell_type, gene, logFC_control, logFC_highfat)
  
  # 6. Create matrix of just logFC columns
  heatmap_mat <- as.matrix(combined_df[, c("logFC_control", "logFC_highfat")])
  rownames(heatmap_mat) <- combined_df$gene
  
  # 7. Compute clustering for rows
  row_hclust <- hclust(dist(heatmap_mat), method = "complete")
  row_dend <- as.dendrogram(row_hclust)
  
  # 8. Reorder the dendrogram primarily by logFC_control
  #    (so that genes with higher logFC_control appear near one end)
  #    agglo.FUN=mean means it uses average logFC_control of sub-branches to order them.
  row_dend_reordered <- reorder(row_dend, w = heatmap_mat[, "logFC_control"], agglo.FUN = mean)
  
  # 9. Optionally flip (reverse) the entire tree top<->bottom
  #    If you see that positive values end up at the bottom, you can do:
  row_dend_flipped <- rev(row_dend_reordered)
  
  # Convert flipped dendrogram back to an hclust object:
  row_hclust_flipped <- as.hclust(row_dend_flipped)
  
  # 10. Plot the heatmap with the custom dendrogram
  pheatmap(
    heatmap_mat,
    cluster_rows = row_hclust_flipped,  # or row_dend_reordered if you don't want to flip
    cluster_cols = FALSE,             # optional
    scale        = "none",            # or "row" if you prefer
    main         = paste("Sig Genes (Glucose vs Saline) -", cell_type)
  )
 return(source_data)  
}


