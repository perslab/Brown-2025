## Function to process differentallly expressed gene 
```{r}
process_DEGs_data <- function(seurat_obj, DEGs_list, celltype_col, group_col, brain_region, fdr_threshold = 0.05, min_cells = 25) {
  # Count cell types
  
  celltype_vec <- seurat_obj[[celltype_col]]
  group_vec <- seurat_obj[[group_col]]

# If either is a data frame, flatten it
if (is.data.frame(celltype_vec)) celltype_vec <- celltype_vec[[1]]
if (is.data.frame(group_vec)) group_vec <- group_vec[[1]]

# Now build the table
celltype_counts <- table(celltype_vec, group_vec)
  #celltype_counts <- table(seurat_obj[[celltype_col]], seurat_obj[[group_col]])
  valid_celltypes <- names(which(apply(celltype_counts, 1, function(x) all(x >= min_cells))))

  # Filter the list of dataframes for significant DEGs
  filtered_list <- DEGs_list %>%
    keep(~ any(.x$FDR < fdr_threshold))

  # Name dataframes in the list
  df_list_named <- map2(filtered_list, names(filtered_list), ~ mutate(.x, celltype = .y))

  # Define a function to convert row names to a column
  add_gene_column <- function(df) {
    df %>%
      dplyr::mutate(gene = row.names(.)) %>%
      dplyr::select(gene, everything())
  }

  # Apply the function to each element of the list
  processed_DEGs <- purrr::map(df_list_named, add_gene_column)

  # Combine and filter
  combined_df <- bind_rows(processed_DEGs, .id = "celltype") %>%
    filter(FDR < fdr_threshold)

  # Generate gene counts
  gene_counts <- combined_df %>%
    group_by(celltype) %>%
    summarize(
      Total = n(),
      Up = sum(logFC > 0),
      Down = sum(logFC < 0)
    ) %>%
    arrange(desc(Total))

  # Merge counts and reorder cell types
  combined_df <- left_join(combined_df, gene_counts, by = "celltype")
  combined_df$celltype <- factor(combined_df$celltype, levels = gene_counts$celltype)

  # Calculate total DE and reorder
  gene_counts <- gene_counts %>%
    mutate(Total_DE = Up + Down)
  combined_df <- combined_df %>%
    mutate(celltype = factor(celltype, levels = gene_counts$celltype[order(gene_counts$Total_DE, decreasing = FALSE)]))

  # Add brain region indicator
  combined_df$brainR <- brain_region

  return(combined_df)
}

```

