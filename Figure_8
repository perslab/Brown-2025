```{r}
addSpeciesAssay <- function(
    x,
    ensembl.mapping,
    species = "mouse",
    assay = "RNA",
    layer = "counts"
) {

  from <- "Gene.name"
  to <- paste0(str_to_title(species), ".gene.name")

  # Check required mapping columns
  required_cols <- c(from, to)

  if (!all(required_cols %in% colnames(ensembl.mapping))) {
    stop(
      "Mapping table must contain: ",
      paste(required_cols, collapse = ", ")
    )
  }

  # Extract counts from the Seurat assay
  expression_mat <- GetAssayData(
    object = x,
    assay = assay,
    layer = layer
  )

  # Keep valid mappings
  mapping <- ensembl.mapping |>
    dplyr::select(
      human_gene = all_of(from),
      mapped_gene = all_of(to)
    ) |>
    dplyr::filter(
      !is.na(human_gene),
      !is.na(mapped_gene),
      human_gene != "",
      mapped_gene != "",
      human_gene %in% rownames(expression_mat)
    ) |>
    dplyr::mutate(mapped_gene_length = nchar(mapped_gene)) |>
    dplyr::arrange(mapped_gene_length) |>
    dplyr::distinct(mapped_gene, .keep_all = TRUE)

  if (nrow(mapping) == 0) {
    stop("No genes in the mapping table matched the RNA assay.")
  }

  # Subset and reorder the matrix to match the mapping table
  mapped_mat <- expression_mat[mapping$human_gene, , drop = FALSE]

  # Replace human row names with mapped mouse gene names
  rownames(mapped_mat) <- mapping$mapped_gene

  # If multiple human genes map to the same mouse gene, sum them
  grouping_mat <- sparse.model.matrix(
    ~ 0 + factor(
      rownames(mapped_mat),
      levels = unique(rownames(mapped_mat))
    )
  )

  new_mat <- Matrix::t(grouping_mat) %*% mapped_mat
  rownames(new_mat) <- unique(rownames(mapped_mat))

  new_assay_name <- paste0(species, "_RNA")

  x[[new_assay_name]] <- CreateAssayObject(counts = new_mat)
  DefaultAssay(x) <- new_assay_name

  message(
    "Created assay '", new_assay_name,
    "' with ", nrow(new_mat), " mapped genes."
  )

  return(x)
}
```


