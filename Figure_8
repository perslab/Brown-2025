cellex_pan <- read.csv(
  "/maps/projects/perslab/people/nvg559/glucose_project_directory/CELLECT/pancreas/cellex/2023_pancrease.esmu.csv.gz",
  row.names = 1,
  check.names = TRUE
) %>%
