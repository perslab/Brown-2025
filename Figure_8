reprocess_obj_human <- function(obj, dims, resolution) {
  obj %>%
    SCTransform(., assay = "mouse_RNA",verbose = F) %>%
    RunPCA(., verbose = FALSE) %>%
    RunUMAP(., dims = 1:dims, return.model=TRUE) %>%
    FindNeighbors(., dims = 1:dims) %>%
    FindClusters(., resolution=resolution)
}

reprocess_obj <- function(obj, dims, resolution) {
  obj %>%
    SCTransform(.,verbose = F) %>%
    RunPCA(., verbose = FALSE) %>%
    RunUMAP(., dims = 1:dims, return.model=TRUE) %>%
    FindNeighbors(., dims = 1:dims) %>%
    FindClusters(., resolution=resolution)
}

project_umap <- function(ref, query) {
  
  anchors <- FindTransferAnchors(reference = ref, query = query, normalization.method = "SCT", recompute.residuals = F,
                                 dims = 1:30, reference.reduction = "pca")
  
  query <- MapQuery(anchorset = anchors, reference = ref, query = query,
                    refdata = list(celltype = "labels_2"), reference.reduction = "pca", reduction.model = "umap")
  
  return(query)
  
}

addSpeciesAssay <- function(x, ensembl.mapping = NULL, species = NULL){
  
  from <- "Gene.name"
  to <- paste0(stringr::str_to_title(species), ".gene.name")
  # Process mapping data
  mapping <- ensembl.mapping[apply(ensembl.mapping[, c(from, to)], 1, function(row) all(row != "")),
                             c(from, to)]
  
  newgenes <- mapping[which(mapping[, 1] %in% rownames(x@assays$RNA)),]
  newgenes <- newgenes[order(nchar(newgenes[,2])),]  # to avoid the many-to-many issue genes are
  newgenes <- newgenes[!duplicated(newgenes[,2]),]    # mapped to the homolog with the shortest name
  defect_genes <- which(newgenes[,1] %in% setdiff(newgenes[,1],rownames(x@assays$RNA)))
  if ( length(defect_genes)>0 ) newgenes<- newgenes[-defect_genes,]
  new_mat <- fac2sparse(newgenes[,2]) %*% x@assays$RNA[newgenes[,1],]
  new_mat <- CreateAssayObject(counts = new_mat)
  x[[paste0(species, '_RNA')]] <- new_mat
  DefaultAssay(x) <- paste0(species, '_RNA')
  return(x)
}
