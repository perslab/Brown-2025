# Convert rownames to a column
cellex_pan <- cellex_pan %>%
  rownames_to_column("ensembl")

gene_lookup <- cellex %>%
  dplyr::select(ENSG, gene) %>%
  dplyr::filter(!is.na(ENSG), ENSG != "") %>%
  dplyr::distinct(ENSG, .keep_all = TRUE)

cellex_pan_annotated <- cellex_pan %>%
  dplyr::rename(ENSG = gene) %>%
  dplyr::left_join(gene_lookup, by = "ENSG")


## 2. Genes shown in the figure

genes_of_interest <- c(
  "ARAP1", "CHD7", "DDC", "DNAH8", "ERN1",
  "FAM83F", "GAD2", "GCK", "GLIS3", "GLP1R",
  "KL", "KRTCAP3", "LMO1", "MYL7", "PDIA5",
  "PIK3R1", "PROX1", "RARB", "RGS17", "TH",
  "TNXB", "TRIM14", "WIPI1"
)


## 3. Standardize gene names

cellex_human <- cellex_human %>%
  mutate(gene = toupper(gene))

cellex_mouse <- cellex_mouse %>%
  mutate(gene = toupper(gene))

cellex_pan <- cellex_pan_annotated %>%
  mutate(gene = toupper(gene))


## 4. Extract the four relevant cell types

df_mouse <- cellex_mouse %>%
  dplyr::select(gene, Ghrh) %>%
  filter(gene %in% genes_of_interest)

df_pancreas <- cellex_pan %>%
  dplyr::select(gene, type_B_pancreatic_cell) %>%
  filter(gene %in% genes_of_interest)

df_human <- cellex_human %>%
  dplyr::select(
    gene,
    C4.160.Mid.1.GABA.6.IL13RA1.GHRH,
    C4.161.Mid.1.GABA.6.IL13RA1.GHRH
  ) %>%
  filter(gene %in% genes_of_interest)


## 5. Combine and reshape

plot_data <- tibble(gene = genes_of_interest) %>%
  left_join(df_mouse, by = "gene") %>%
  left_join(df_human, by = "gene") %>%
  left_join(df_pancreas, by = "gene") %>%
  pivot_longer(
    cols = -gene,
    names_to = "cell_type",
    values_to = "cellex_score"
  )


## 6. Define ordering and score categories

plot_data <- plot_data %>%
  mutate(
    gene = factor(
      gene,
      levels = genes_of_interest
    ),

    cell_type = factor(
      cell_type,
      levels = c(
        "type_B_pancreatic_cell",
        "C4.161.Mid.1.GABA.6.IL13RA1.GHRH",
        "C4.160.Mid.1.GABA.6.IL13RA1.GHRH",
        "Ghrh"
      )
    ),

    score_group = case_when(
      is.na(cellex_score)   ~ "NA",
      cellex_score < 0.25   ~ "Low",
      cellex_score < 0.50   ~ "Medium–Low",
      cellex_score < 0.75   ~ "Medium–High",
      cellex_score >= 0.75  ~ "High"
    ),

    score_group = factor(
      score_group,
      levels = c(
        "Low",
        "Medium–Low",
        "Medium–High",
        "High",
        "NA"
      )
    )
  )


## 7. Plot

plot <- ggplot(
  plot_data,
  aes(x = gene, y = cell_type)
) +
  geom_tile(
    fill = "grey98",
    color = "white",
    linewidth = 1.5
  ) +
  geom_point(
    aes(color = score_group),
    size = 4
  ) +
  scale_color_manual(
    name = expression(bolditalic(ES)[mu]),
    values = c(
      "Low"         = "grey82",
      "Medium–Low"  = "#9ECAE1",
      "Medium–High" = "#1F78B4",
      "High"        = "#A1D76A",
      "NA"          = "grey50"
    ),
    drop = FALSE
  ) +
  scale_x_discrete(drop = FALSE) +
  scale_y_discrete(drop = FALSE) +
  theme_pubr(legend = "top") +
