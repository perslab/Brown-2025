```{r}
library(dplyr)

data_summary <- function(data, varname, groupnames) {
  summary_func <- function(x, col) {
    n <- sum(!is.na(x[[col]]))  # Number of non-NA observations
    sd_value <- sd(x[[col]], na.rm = TRUE)  # Standard Deviation

    c(mean = mean(x[[col]], na.rm = TRUE),
      sd = sd_value,
      sem = sd_value / sqrt(n))  # Standard Error of the Mean
  }

  data_sum <- data %>%
    group_by(across(all_of(groupnames))) %>%
    summarise(across(all_of(varname), list(mean = ~mean(.x, na.rm = TRUE),
                                           sd = ~sd(.x, na.rm = TRUE),
                                           sem = ~sd(.x, na.rm = TRUE) / sqrt(sum(!is.na(.x))))),
              .groups = 'drop') %>%
    dplyr::rename(!!varname := paste0(varname, "_mean"))

  return(data_sum)
}
```

# Define a custom theme
```{r}
custom_theme <- theme(
  text = element_text(size = 12),
  axis.title = element_text(size = 12),
  axis.text = element_text(size = 12),
  legend.title = element_blank(),
  legend.position = "none",
  panel.background = element_blank(),  # Remove panel background
  panel.grid.major = element_blank(),  # Remove major grid lines
  panel.grid.minor = element_blank(),  # Remove minor grid lines
  axis.line.y = element_line(color = "black", size = 0.5),  # Add y-axis line
  axis.line.x = element_line(color = "black", size = 0.5), axis.ticks.y = element_line(color = "black", size = 0.5),  # Add y-axis ticks
  axis.ticks.x = element_line(color = "black", size = 0.5)   # Add x-axis ticks   # Add x-axis line
)

# Create a new theme based on custom_theme for glucose timecourse
custom_theme_with_legend <- custom_theme +
  theme(legend.position = "top") 
```


##PLot Body weight values over time
```{r}
Bw.group <- readRDS("/projects/perslab/data/yggdrasil/projects/nvg559/Glucose_paper/Anthropometrics/Timecouse_data_Treatment_Groups_BW.rds")

BW_values <- data_summary(Bw.group, varname="Bw", 
                    groupnames=c("diet", "time"))

BW_values$diet <- factor(BW_values$diet, levels = c(1, 2), labels = c("Control", "HFD"))

Bw.plot <- ggplot(data = BW_values, aes(x = time, y = Bw, col = diet, group = diet)) +  
  geom_errorbar(aes(ymin = Bw, ymax = Bw+Bw_sem), width = 0.15, size = 0.4) +
  geom_line(size = 0.6) +
  geom_point(size = 1.5) +
  scale_x_continuous(name = "Time (wks)", 
                   breaks = seq(0, 8, 1)) +
  scale_y_continuous(name = "Body Weight (g)", 
                     breaks = seq(0, 40, 10),
                     limits = c(0, 40)) +
  theme_pubr(legend = "top") + 
  guides(col = guide_legend(nrow=1, byrow = T)) +
  scale_color_manual(values = c("Control" = "grey", "HFD" = "black"))+
  custom_theme_with_legend

# Print the plot
print(Bw.plot)

