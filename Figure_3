## Fig. 3c: Volcano plots

```{r}
DEGs.neurons.sal <- readRDS(
  file.path(output_dir, "DE_ALL", "DEGs_edgeR_ARCC_neurons_Controltreatment_diet_response_final_no_NA_m.rds")
)

make_volcano <- function(de_list, celltype_name, label_n = 6) {

  de_list[[celltype_name]] %>%
    rownames_to_column(var = "gene") %>%
    mutate(
      neg_log10_p = -log10(PValue),
      direction = case_when(
        logFC > 0 ~ "up",
        logFC < 0 ~ "down",
        TRUE ~ NA_character_
      ),
      candidate = abs(logFC) >= 0.4 & FDR < 0.05
    ) -> df

  df |>
    tidyplot(x = logFC, y = neg_log10_p) |>
    add_data_points(
      data = filter_rows(!candidate),
      color = "lightgrey",
      rasterize = TRUE
    ) |>
    add_data_points(
      data = filter_rows(candidate, direction == "up"),
      color = "#FF7777",
      alpha = 0.5
    ) |>
    add_data_points(
      data = filter_rows(candidate, direction == "down"),
      color = "#7DA8E6",
      alpha = 0.5
    ) |>
    add_data_labels_repel(
      data = min_rows(FDR, label_n, by = direction),
      label = gene,
      color = "#000000",
      min.segment.length = 0,
      background = TRUE
    ) |>
    adjust_x_axis_title("$Log[2]~fold-change$") |>
    adjust_y_axis_title("$-Log[10]~italic(P)$")
}

volcano_Th_Slc6a3 <- make_volcano(DEGs.neurons.sal, "Th_Slc6a3")
volcano_Agrp <- make_volcano(DEGs.neurons.sal, "Agrp")
volcano_Ghrh <- make_volcano(DEGs.neurons.sal, "Ghrh")
volcano_Trh_Cxcl12 <- make_volcano(DEGs.neurons.sal, "Trh_Cxcl12")

volcano_Th_Slc6a3
volcano_Agrp
volcano_Ghrh
volcano_Trh_Cxcl12
