## Fig. 3b: DE gene counts and log2 fold-change dot plot

```{r}
DE_data <- readRDS(
  file.path(output_dir, "Combine_arc_dvc", "new_Con_IV_diet_response_arc_dvc_neurons.rds")
)

custom_theme <- function() {
  theme_pubr() +
    theme(
      axis.text.y = element_text(size = 8),
      axis.title = element_text(size = 8),
      axis.text.x = element_text(size = 6, angle = 0, hjust = 1),
      legend.position = "none",
      title = element_text(size = 8),
      plot.margin = unit(c(0, 0, 0.25, 0), "cm"),
      plot.title = element_text(hjust = 0.5),
      axis.line = element_line(colour = "black", linewidth = 0.3),
      axis.ticks = element_line(colour = "black", linewidth = 0.3)
    )
}

deg_count_plot <- ggplot(
  DE_data,
  aes(x = Total, y = fct_reorder(celltype, Total), fill = brainR)
) +
  geom_col(position = position_dodge(), width = 0.5, linewidth = 0.3) +
  scale_fill_manual(values = pal) +
  theme_pubr() +
  custom_theme() +
  ylab(NULL) +
  xlab("Number of differentially expressed genes") +
  scale_x_continuous(breaks = seq(0, 60, 10), position = "top")

logfc_dot_plot <- ggplot(
  DE_data,
  aes(x = logFC, y = fct_reorder(celltype, Total), colour = brainR)
) +
  geom_point(alpha = 0.5, size = 2) +
  scale_color_manual(values = pal) +
  labs(
    x = expression(Log[2] ~ "fold-change"),
    y = "Neuron populations"
  ) +
  scale_x_continuous(position = "top") +
  custom_theme()

fig_3b <- logfc_dot_plot +
  plot_spacer() +
  (deg_count_plot + theme(axis.text.y = element_blank())) +
  plot_layout(widths = c(1.75, 0.05, 1.2))

fig_3b
