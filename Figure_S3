```{r, fig.height= 5}
astroterms.down <- GO.terms.astro.diet.down %>% dplyr::select(term_name,p_value,source) %>% top_n(6, wt = -p_value) %>%  pull(term_name)
astroterms.up <- GO.terms.astro.diet.up %>% dplyr::select(term_name,p_value,source) %>% top_n(6, wt = -p_value) %>%  pull(term_name)

allterms <- c(astroterms.down,astroterms.up)

combined_data <- bind_rows(GO.terms.astro.diet.down %>% dplyr::select(term_name,p_value,source, intersection),
          GO.terms.astro.diet.up %>% dplyr::select(term_name,p_value,source, intersection),
          .id="ct") %>% 
  filter(term_name %in% allterms)

heatmap_data <- combined_data %>% mutate(
    term_name = str_to_title(str_wrap(term_name, 30), locale = "en"),
    ctt = factor(ct, levels = c("1", "2"), labels = c("DIO-down", "DIO-up")),
    neg_log_p_value = ifelse(is.na(p_value), NA, -log10(p_value))
  )

write.xlsx(
  heatmap_data,
  file = "/projects/perslab/people/nvg559/glucose_project_directory/data/processed/astrcoyte_HFD_goterms.xlsx",
  overwrite = TRUE
) 

ggplot(heatmap_data, aes(
  x = reorder(term_name, neg_log_p_value),
  y = neg_log_p_value,
  fill = ctt
)) +
  geom_col(color = NA, width = 0.7) +     # No outlines
  coord_flip() +
  # Manually define colors for the two groups
  scale_fill_manual(values = c("DIO-up" = "darkgrey", 
                               "DIO-down" = "lightgrey")) +
  labs(x = NULL, y = expression(-log[10](p))) +
  theme_minimal(base_size = 14) +
  theme(legend.title = element_blank())-> dd_plot

