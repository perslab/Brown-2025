```{r}
list_down <-DEGs.neurons.sal$Astrocytes %>% filter(FDR<=0.05) %>% filter(logFC<0) %>% rownames_to_column() %>% pull(rowname)
list_up <-DEGs.neurons.sal$Astrocytes %>% filter(FDR<=0.05) %>% filter(logFC>0) %>% rownames_to_column() %>% pull(rowname)
arc_dvc_astro <-subset(arc_dvc, subset = sub.class == "Astrocytes")
gene_names <- rownames(arc_dvc_astro[["RNA"]])
```

```{r}
module.GO.terms.astro <- gost(query = list_up,
                        organism = "mmusculus",
                        custom_bg = gene_names,
                        ordered_query = F, correction_method = "fdr",
                        exclude_iea = T,
                        sources = c("GO:BP", "GO:MF", "GO:CC", "KEGG", "REAC"),
                        evcodes = T)

  
GO.terms.astro.diet.up <- module.GO.terms.astro[[1]] %>% dplyr::select(term_name, term_size,source, p_value,
                                            intersection_size, term_id, intersection) %>%
  filter(term_size <= 500) %>% arrange(p_value) %>% filter(p_value <0.05) %>%
  mutate(x = fct_reorder(str_wrap(term_name, 6), -p_value)) %>%
  mutate(y = -log10(p_value)) %>%
  mutate(cell.type = "Astrocyte_diet_up")
```
