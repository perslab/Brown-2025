#Run scDist Analysis 
```{r}
merged_all <- qread("/projects/perslab/data/yggdrasil/projects/nvg559/Glucose_paper/Brown-2024/Data/Raw_filtered_labeled_arc_dvc_major_class.qs")
# 1) Count the number of cells per (sample.ID, major.class)
df_counted <- merged_all[[]] %>%
  dplyr::group_by(sample.ID,brainR,major.class) %>%
  dplyr::summarise(n = n(), .groups = "drop")

# 2) For each major.class, contain cells froma all sample with at least 4 samples containing >40 cells
df_summary <- df_counted %>%
  dplyr::group_by(major.class) %>%
  dplyr::summarise(
    # total_samples = how many distinct samples exist for that class
    total_samples = n_distinct(sample.ID),
    combos_over_40 = sum(n > 40),
    .groups = "drop"
  ) %>%
  # 3) Keep only classes where combos_over_10 == total_samples
  #    This ensures *every* sample has >10 cells for that class
  dplyr::filter(total_samples == 40)

unique(df_summary$major.class)->keep
sub<- subset(merged_all, subset = major.class %in% keep)
sub <- NormalizeData(sub)
sub <- FindVariableFeatures(sub, nfeatures = 5000)
sub <- ScaleData(sub)
sub_res <- scDist(as.matrix(sub@assays$RNA@data[VariableFeatures(sub),]), sub@meta.data, 
                                              fixed.effects = "brainR", d = 10, min.counts.per.cell = 20,
              random.effects=c("sample.ID","orig.ident"),
              clusters="major.class")
sub_res$results
```
