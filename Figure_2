  n_DEG = NA_integer_
)

for (i in seq_len(nrow(DEGs.DVC.counts))) {
  cell.type <- DEGs.DVC.counts$cell.type[i]
  deg_table <- DEGs.DVC.Control[[cell.type]]
  
  if (is.data.frame(deg_table) && "FDR" %in% names(deg_table)) {
