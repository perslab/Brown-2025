# Fig. 2g: Volcano plot DE genes ARC/VMH astrocytes
```{r}
DEGs.nonneurons <-
    readRDS(file.path(data_dir, "DEGs_edgeR_ARC_nonneurons_diet_response_saline_group_final_no_NA.rds")

DEGs.nonneurons$Astrocytes %>% rownames_to_column(var = "gene") %>%  mutate(
    neg_log10_padj = -log10(PValue),
    direction = if_else(logFC > 0, "up", "down", NA),
    candidate = abs(logFC) >= 0.4 & FDR < 0.05
    ) ->df

df |> 
  tidyplot(x = logFC, y = neg_log10_padj) |> 
  add_data_points(data = filter_rows(!candidate),
                  color = "lightgrey", rasterize = TRUE) |> 
  add_data_points(data = filter_rows(candidate, direction == "up"),
                  color = "#FF7777", alpha = 0.5) |> 
  add_data_points(data = filter_rows(candidate, direction == "down"),
                  color = "#7DA8E6", alpha = 0.5)  |> 
  add_data_labels_repel(data = min_rows(FDR, 6, by = direction), label = gene,
                        color = "#000000", min.segment.length = 0, background = TRUE) |> 
  adjust_x_axis_title("$Log[2]~fold-change$") |> 
  adjust_y_axis_title("$-Log[10]~italic(P)~adjusted$")-> plot
```
