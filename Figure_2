# Fig. 2f: Number of FDR-significant DE genes by non-neuronal cell type
```{r}
custom_theme <- function() {
  theme_pubr() +
    theme(
      axis.text.y = element_text(size = 12),
      axis.title = element_text(size = 6),
      axis.text.x = element_text(size = 6, angle = 0, hjust = 1),
      legend.position = "none",
      title = element_text(size = 8),
      plot.margin = unit(c(0, 0, 0.25, 0), "cm"),
      plot.title = element_text(hjust = 0.5),
      axis.line = element_line(colour = "black", linewidth = 0.3),
      axis.ticks = element_line(colour = "black", linewidth = 0.3)
    )
}

dvc_nonneuronal <- subset(arc_dvc_non_labeled, subset = brainR == "DVC")

DEGs.ARC.Control <- readRDS(
  file.path(output_dir, "DEGs_edgeR_ARC_nonneurons_diet_response_saline_group_finalwNA.rds")
)

DEGs.DVC.Control <- readRDS(
  file.path(output_dir, "DEGs_edgeR_DVC_nonneurons_diet_response_saline_group_finalwNA.rds")
)

arc_celltype_counts <- table(arc_dvc_non_labeled$sub.class)
arc_valid_celltypes <- names(arc_celltype_counts[arc_celltype_counts >= 25])

DEGs.ARC.counts <- data.frame(
  cell.type = arc_valid_celltypes,
  n_DEG = NA_integer_
)

for (i in seq_len(nrow(DEGs.ARC.counts))) {
  cell.type <- DEGs.ARC.counts$cell.type[i]
  deg_table <- DEGs.ARC.Control[[cell.type]]
  
  if (is.data.frame(deg_table) && "FDR" %in% names(deg_table)) {
    DEGs.ARC.counts$n_DEG[i] <- sum(deg_table$FDR < 0.05, na.rm = TRUE)
  } else {
    DEGs.ARC.counts$n_DEG[i] <- 0
  }
}

dvc_celltype_counts <- table(dvc_nonneuronal$sub.class)
dvc_valid_celltypes <- names(dvc_celltype_counts[dvc_celltype_counts >= 25])

DEGs.DVC.counts <- data.frame(
